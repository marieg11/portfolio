<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Name - Portfolio</title>
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="images/favicon.png" />
  <meta name="description" content="Portfolio of Name - experience, projects, and skills." />
  <meta name="color-scheme" content="light dark" />
  <style>
    /* ===================== THEME ===================== */
    :root{
      --bg:#123456;
      --panel:#2b5475;       /* card & button background */
      --text:#f0f0f0;
      --muted:#c5c5c5;       /* skills chip text color */
      --ring:#2a4466;
      --shadow:none;         /* no shadows in dark mode */

      /* Hero title size */
      --hero-size:clamp(24px, 4vw, 34px);

      /*spacing between sections*/
      --section-spacing:40px;   
    }
    :root.light{
      --bg:#d5f5d1;
      --panel:#eafae8;
      --text:#1f1f1f;
      --muted:#898989;
      --ring:#2a4466;
      --shadow:none;         /* no shadows in light mode */
    }

    /* ===================== BASE ===================== */
    *{box-sizing:border-box}
    html,body{min-height:100%}
    body{
      margin:0;
      font:16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      background:var(--bg);
      color:var(--text);
    }
    .container{max-width:1100px; margin:0 auto; padding:24px}
    a{color:var(--text); text-decoration:none}
    a:hover{text-decoration:underline}

    /* Buttons (neutral) */
    .btn{
      display:inline-flex; align-items:center; gap:8px;
      padding:10px 14px; border-radius:12px; border:1px solid var(--ring);
      background:var(--panel); color:var(--text); text-decoration:none;
      box-shadow:var(--shadow);
      font-size:1rem; line-height:1.6;
      height:34px;               /* unify height with header buttons */
    }
    .btn:hover{
      text-decoration:underline;
    }

    .btn--ghost{background:var(--panel)}

    .btn--quiet{
      background:transparent; border:1px solid var(--ring);
      color:var(--muted); box-shadow:var(--shadow); padding:6px 10px; border-radius:10px;
      font-size:1rem; line-height:1.6;
      height:auto;               /* allow smaller quiet buttons; min-height added later */
    }
    .btn--quiet:hover{
      background:color-mix(in oklab, var(--panel) 85%, transparent);
      text-decoration:underline;
    }

    /* ===== Header (Left / Center / Right) ===== */
    header{
      position:sticky;
      top:0;
      z-index:20;
      backdrop-filter:saturate(160%) blur(8px);
      background:color-mix(in oklab, var(--bg) 85%, transparent);
      border-bottom:1px solid color-mix(in oklab, var(--ring) 50%, transparent);
    }
    nav.nav{
      display:grid;
      grid-template-columns:auto 1fr auto; /* left / center / right */
      align-items:center;
      column-gap:16px;
      row-gap:8px;
    }
    .nav-left{
      display:flex;
      align-items:center;
      gap:10px;
    }
    .nav-center{
      display:flex;
      justify-content:center;
      align-items:center;
    }
    /* Hide desktop nav buttons on all screen sizes */
    .nav-links{
      display:none;
      justify-content:center;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }
    .nav-right{
      display:flex;
      align-items:center;
      gap:10px;
      justify-content:flex-end;
      justify-self:end;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      text-decoration:none; color:inherit; font-weight:700;
    }
    .logo{
      width:34px; height:34px; border-radius:10px; display:grid; place-items:center;
      background:var(--panel); color:var(--text); border:1px solid var(--ring); box-shadow:var(--shadow);
    }
    .nav-center .btn{box-shadow:var(--shadow)}

    /* Toggle: rounded rectangle */
    .toggle{
      border:1px solid var(--ring);
      border-radius:10px;
      padding:6px 12px;
      background:var(--panel);
      display:inline-flex;
      align-items:center;
      gap:6px;
      color:var(--text);
      font-weight:600;
      font-size:0.9rem;
      box-shadow:var(--shadow);
      cursor:pointer;
      height:34px;          /* same height as logo & menu */
      line-height:1;
    }
    .toggle:hover #{
      text-decoration:underline;
    }

    /* ===== Hamburger button (now visible on ALL screen sizes) ===== */
    .menu-toggle{
      border:1px solid var(--ring);
      border-radius:10px;
      padding:6px 12px;
      background:var(--panel);
      color:var(--text);
      cursor:pointer;
      font-size:1.2rem;
      box-shadow:var(--shadow);
      height:34px;            /* same height */
      line-height:1;
      align-items:center;
      justify-content:center;
      display:inline-flex;     /* <- always visible */
    }

    .mobile-menu{
      position:fixed;
      top:var(--header-height, 72px); /* fallback 72px */
      /*right:24px;                            same padding as .container → lines up with ☰ */
      right:1.5rem;                   /* sits under the hamburger on small screens */
      left:auto;                            /* no longer full-width */
      width:min(360px, 70vw);               /* narrower panel (max ~340px, 70% of viewport) */

      background:color-mix(in oklab, var(--panel) 85%, transparent);
      backdrop-filter:saturate(160%) blur(8px);   /* same “frosted” feel as header */
      box-shadow:var(--shadow);
      /*border-radius:0 0 0 16px;             optional: soften inner corner */
      border-radius:16px;

      padding:16px 24px 24px;
      display:none;
      z-index:30;                           /* above sticky header (which is 20) */

      /* limit height and allow scrolling inside */
      max-height:calc(100vh - var(--header-height, 72px) - 16px);
      overflow-y:auto;
    }
    .mobile-menu.open{
      display:block;
    }
    .mobile-menu-header{
      display:flex;
      justify-content:flex-end;    /* X on the right edge = under the ☰ button */
      /*margin:4px 0 8px 0;     tiny top margin so it isn’t glued to the edge */
      margin-bottom:8px;
    }

    /* On wide screens, align the panel with the right edge of the 1100px container */
    @media (min-width: 1200px){
      .mobile-menu{
        right:calc((100vw - 1100px)/2 + 24px);
        /*              ^ container side margin  ^ container padding */
      }
    }
    
    .mobile-menu-close{
      border:none;
      background:transparent;
      color:var(--text);
      font-size:1.4rem;
      cursor:pointer;
    }
    .mobile-menu a{
      display:block;
      padding:10px 0;
      color:var(--text);
      text-decoration:none;
      font-size:1.05rem;
    }
    .mobile-menu a:hover{
      text-decoration:underline;
    }

    .visually-hidden{
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0 0 0 0);
      white-space:nowrap;
      border:0;
    }

    /* On small screens:
       - keep hamburger
       - hide text label on theme toggle
    */
    @media (max-width:700px){
      #{
        display:none;          /* emoji only */
      }
      .toggle{
        padding:6px 8px;       /* tighter horizontally; height stays 34px */
      }
    }

    /* ===== Top ===== */
    .top{display:grid; gap:18px; padding:var(--section-spacing) 0}
    .top .contact{display:flex; flex-wrap:wrap; gap:10px}
    .pill{border:1px solid var(--ring); border-radius:999px; padding:6px 10px; color:var(--muted); background:color-mix(in oklab, var(--panel) 70%, transparent)}
    .summary{display:grid; gap:6px}
    h1{
      font-size:var(--hero-size);
      margin:0;
      line-height:1.1;
    }
    .elevator{font-size:1.05rem; color:var(--muted)}

    /* ===== Sections / Cards ===== */
    .section{padding:var(--section-spacing) 0}
    .section h2{margin:0 0 12px 0}
    .card{
      background:var(--panel);
      border:1px solid var(--ring);
      border-radius:16px;
      padding:16px;
      box-shadow:var(--shadow);
    }
    footer{padding:28px 0; color:var(--muted); text-align:center}
    .copyright{
      color:var(--text);
    }
    section{
      scroll-margin-top:80px;   /* adjust to your header height */
    }

    /* ===== Timeline ===== */
    .timeline{position:relative; margin:24px 0;}
    .timeline::before{
      content:"";
      position:absolute;
      top:0;
      bottom:0;
      left:50%;
      width:2px;
      background:linear-gradient(180deg, transparent, var(--ring), transparent);
      z-index:0;
    }
    .item{position:relative; width:50%; padding:14px;}
    .item h3{margin:0 0 4px 0}
    .item .meta{color:var(--muted); font-weight:600; margin-bottom:8px}
    .item .meta a {
      color: inherit;        /* use the same muted color */
      font-weight: inherit;  /* don't make it heavier */
      text-decoration: none; /* no underline by default */
    }
    .item .meta a:hover {
      color: inherit;        /* stay same color on hover */
      text-decoration: underline; /* just add the underline */
    }
    .item ul{margin:8px 0 0 0;    /* no outer left margin */
      padding-left:18px; /*small padding so bullets don’t touch the border*/
    }
    .item[data-side="left"]{left:0; padding-right:28px}
    .item[data-side="right"]{left:50%; padding-left:28px}
    .dot{
      position:absolute;
      top:22px;
      left:50%;
      transform:translate(-50%,-50%);
      background:var(--panel);
      border:2px solid var(--ring);
      width:55px; /*logo box sizes*/
      height:55px;
      border-radius:12px;
      display:grid;
      place-items:center;
      box-shadow:var(--shadow);
      z-index:2;
    }
    .dot img{width:40px; height:40px} /*logo sizes*/

    .item .card{
      background:var(--panel);
      z-index:1;
      position:relative;
    }
    .timeline .card{
      padding-top:40px; /* push content down so logo doesn't collide with title */
    }


    /* ===== Education grid ===== */
    .edu-subsection{
      margin-top:25px;                 /* space BEFORE the subsection title */
    }

    /* Extra spacing before every subsection that follows another one (so “Certificates & Courses”, etc.) */
    .edu-subsection + .edu-subsection{
      margin-top:50px;   
    }

    /* Subsection titles: same look as "Programming" in Skills card */
    .edu-label{
      font-size:1.25rem;
      font-weight:600;
      color:var(--muted);
      margin:0;  
    }

    /* Grid: 1 column on small, MAX 2 columns on wider screens */
    .edu-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));       /* default = single column */
      row-gap:45px;                    /* vertical space between rows */
      column-gap:18px;                 /* horizontal space between cards */
      margin-top:50px;                 /* space AFTER the title, before the cards */
    }

    
    @media (min-width: 780px){
      .edu-grid{
        grid-template-columns:repeat(2, minmax(0, 1fr)); /* at most 2 per row */
      }
    }
    

    /* Make edu cards behave like experience cards */
    .edu-card{
      position:relative;
      padding:16px;
      padding-top:45px;                /* so the title doesn't crash into logo */
    }

    /* Heading & meta inside edu cards = same as experience */
    .edu-card h3{
      margin:0 0 4px 0;                /* tight gap under title (like .item h3) */
    }

    .edu-card .meta{
      color:var(--muted);
      font-weight:600;
      margin-bottom:8px;
    }

    /* Bullet spacing in education cards = experience cards */
    .edu-card ul{
      margin:8px 0 0 0;
      padding-left:18px;               /* slight indent so bullets don't hit edge */
    }

    /* Icon capsule: centered on top edge like experience logos */
    .edu-icon{
      position:absolute;
      top:0;
      left:50%;
      transform:translate(-50%, -50%);
      
      width:55px;  /*size of logo box*/
      height:55px;
      padding:4px;
      
      border-radius:12px;
      background:var(--panel);
      border:2px solid var(--ring);
      
      place-items:center;
      display:grid;
    }

    
    /* Make the link fill the whole capsule */
    .edu-icon a{
      display:grid;
      place-items:center;
      width:100%;
      height:100%;
      text-decoration:none;
    }
    
    .edu-icon img{ /*control image size inside logo box*/
      width:90%;
      height:90%;
      object-fit:contain;

      /* smooth hover on the logo itself */
      transition:
        transform 150ms ease,
        filter 150ms ease;
    }

    /* Hover effect for the logo capsule */
    @media (hover:hover){
      .edu-icon:hover img{
        transform:scale(1.05);
        filter:brightness(1.05);
      }
    }


    /* MOBILE TIMELINE LAYOUT – make left & right items look the same */
    @media (max-width: 900px){
      .timeline::before{left:20px}
      .item{
        width:100%;
        left:0 !important;
        padding:14px 14px 14px 34px; /*control space between logo and card*/
      }
      .item[data-side="left"],
      .item[data-side="right"]{
        padding-left:34px; /*control space between logo and card*/
        padding-right:14px;
      }
      .dot{left:20px}
    }
    
    .dot a{
      display:grid;
      place-items:center;
      width:100%;
      height:100%;
    } /*so the link fills the dot*/

    .dot a:hover img{
      /* optional tiny hover effect */
      transform:scale(1.03);
    }


    /* ===== Grid (Projects) ===== */
    .grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:16px}
    /*.card img{width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:10px; margin-bottom:10px}*/
    .project-card img{width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:10px; margin-bottom:10px}


    /* ===== Project video thumbnails (test 2) ===== */
    .proj-thumbnail-button{
      background:none;
      border:none;
      padding:0;
      margin:0;
      width:100%;
      text-align:inherit;
      display:block;
      cursor:pointer;
    }

    .proj-thumbnail-wrapper{
      position:relative;
      border-radius:10px;
      overflow:hidden;
    }

    .proj-thumbnail-wrapper img{
      display:block;
      width:100%;
      transition:transform 0.25s ease, filter 0.25s ease;
    }

    /* Hover effect: slight zoom + darken (desktop / hover devices only) */
    @media (hover:hover){
      .proj-thumbnail-wrapper:hover img{
        transform:none;
        filter:none;
      }
    }

    /* “Play” cue: centered rounded button */
    .proj-thumbnail-play{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%, -50%);
      width:52px;
      height:52px;
      background:rgba(0,0,0,0.55);  /* button fill color */
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:12px;
      transition:
          background 150ms ease,
          transform 150ms ease,
          box-shadow 150ms ease;
    }

    /* Hover effect on the play button */
    @media (hover:hover){
      .proj-thumbnail-play:hover{
        background:rgba(0,0,0,0.8);              /* darker */
        transform:translate(-50%, -50%) scale(1.06); /* slight pop */
        box-shadow:0 4px 10px rgba(0,0,0,0.35);
      }
    }

    .proj-thumbnail-play::before{
      content:"";
      width:0;
      height:0;
      border-left:18px solid #ffffff;     /* triangle color */
      border-top:11px solid transparent;
      border-bottom:11px solid transparent;
      margin-left:3px;                    /* optical centering */
    }

    /* ===== Video overlay popup ===== */
    .proj-video-overlay{
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.6);
      display:none;
      align-items:center;
      justify-content:center;
      z-index:40;
    }

    .proj-video-overlay.open{
      display:flex;
    }

    .proj-video-inner{
      background:var(--panel);
      border-radius:16px;
      padding:8px;
      max-width:550px;
      width:80%;
      box-shadow:var(--shadow);
    }

    .proj-video-inner video{
      display:block;
      width:100%;
      border-radius:10px;
      max-height:55vh;
    }

    .proj-video-close{
      background:transparent;
      border:none;
      color:var(--text);
      font-size:1.4rem;
      cursor:pointer;
      align-self:flex-end;
      margin-bottom:4px;
    }

    @media (max-width:700px){
      .video-modal{
        width:80vw;
        max-width:none;
      }
    }

    /* ===== Chips (skills) ===== */
    .badges{display:flex; flex-wrap:wrap; gap:8px; margin-top:8px}
    .badge{
      font-size:1rem; line-height:1.6;
      padding:6px 10px; border-radius:999px;
      border:1px solid var(--ring);
      color:var(--muted); background:transparent;
    }

    /* === Unified chip / quiet-button height === */
    .pill,
    .badge,
    .btn--quiet{
      display:inline-flex;
      align-items:center;
      min-height:30px;    /* control height here */
      padding:4px 10px;   /* a bit less vertical padding */
      line-height:1.3;    /* tighter line height than 1.6 */
    }

    /* Small icon buttons at bottom of cards */
    .card-links{
      margin-top:10px;
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .card-links a{
      text-decoration:none;      /* remove underline on icons */
    }

    /* Circular icon button */
    .icon-circle{
      --icon-size:40px;          /* tweak this to make box bigger/smaller */

      width:var(--icon-size);
      height:var(--icon-size);
      border-radius:12px;
      border:1px solid var(--ring);
      background:var(--panel);
      
      display:grid;
      /*align-items:center;
      justify-content:center;*/
      place-items:center;   /* centers content exactly like .edu-icon */

      padding:0;                    /* no extra padding */
      line-height:0;                 kill inline text line box 

      
      /*font-size:1rem;            size of emoji / glyph inside
      color:var(--text);*/
      box-shadow:var(--shadow);
      transition:
        background 150ms ease,
        transform 150ms ease,
        box-shadow 150ms ease;
    }

    .icon-circle:hover{
      background:color-mix(in oklab, var(--panel) 80%, transparent);
      transform:translateY(-1px);
      text-decoration:none;
    }

    /* Make image icons fit nicely inside the circle */
    .icon-circle img{
      width:25px;          /* change these to adjust image size */
      height:25px;
      object-fit:contain;
      display:block; /* remove baseline gap */
      justify-self:center;             /* extra “belt & suspenders” centering */
      align-self:center;
    }


    /* ===== Project meta ===== */
    .proj-meta{margin:6px 0 8px 0; color:var(--muted); font-weight:600}
    .proj-meta strong{color:inherit; font-weight:700}
    .proj-meta a{
      color: inherit;
      font-weight: inherit;
      text-decoration: none;
    }
    .proj-meta a:hover{
      color: inherit;
      text-decoration: underline;
    }

    /* Optional: make the thumbnail link behave like a block */
    .project-image-link{
      display: block;
    }
    .project-image-link img{
      display: block;
      transition:none;
    }
    .project-image-link:hover img,
    .project-image-link:focus-visible img{
      transform:none;
      filter:none;
    }
    
    /* ===== Skills & Contact styling ===== */
    #skills .card, #skills .card *{color:var(--muted)}
    #contact .card, #contact .card *, #contact .card strong{color:var(--muted)}
    #contact .card strong{font-weight:600}

    #skills .card h3{
      font-size:1rem;
      font-weight:600;
      margin:0 0 8px 0;
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <nav class="nav" aria-label="Primary">
        <div class="nav-left">
          <a class="brand" href="#about" data-scroll="#about">
            <img src="images/favicon.png" alt="personal logo" class="logo">
          </a>
        </div>

        <div class="nav-center">
          <!-- Desktop nav buttons kept in DOM but hidden via CSS -->
          <div class="nav-links" aria-label="Section navigation">
            <a class="btn btn--ghost" href="#about"        data-scroll="#about">About</a>
            <a class="btn btn--ghost" href="#experience" data-scroll="#experience">Experience</a>
            <a class="btn btn--ghost" href="#volunteer"  data-scroll="#volunteer">Volunteer</a>
            <a class="btn btn--ghost" href="#projects"   data-scroll="#projects">Projects</a>
            <a class="btn btn--ghost" href="#education"   data-scroll="#education">Education</a>
            <a class="btn btn--ghost" href="#skills"     data-scroll="#skills">Skills</a>
            <a class="btn btn--ghost" href="#contact"    data-scroll="#contact">Contact</a>
          </div>
        </div>

        <div class="nav-right">
          <button id="themeToggle" type="button" class="toggle" aria-pressed="false" title="Toggle theme">
            <span id="themeIcon">☀️</span>
            <!-- <span id="themeIcon">☀️</span><span id="">Light Mode</span> this is if you want text next to light toggle emoji -->
          </button>

          <!-- Hamburger menu button (desktop + mobile) -->
          <button id="menuToggle" class="menu-toggle" type="button"
                  aria-label="Open navigation" aria-expanded="false">
            ☰
          </button>
        </div>
      </nav>
    </div>
  </header>

  <!-- Mobile / overlay menu panel (used for ALL screen sizes now) -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-header">
      <button id="mobileMenuClose" class="mobile-menu-close" type="button" aria-label="Close navigation">✕</button>
    </div>
    <nav aria-label="Mobile navigation">
      <a href="#about"        data-scroll="#about">About</a>
      <a href="#experience" data-scroll="#experience">Experience</a>
      <a href="#volunteer"  data-scroll="#volunteer">Volunteer</a>
      <a href="#projects"   data-scroll="#projects">Projects</a>
      <a href="#education"   data-scroll="#education">Education</a>
      <a href="#skills"     data-scroll="#skills">Skills</a>
      <a href="#contact"    data-scroll="#contact">Contact</a>
    </nav>
  </div>

  <main id="top" class="container">
    <!-- ===== TOP ===== -->
    <section id="about" class="top" aria-labelledby="intro-title">
      <h1 id="intro-title">Software Engineer &amp; Product-minded Builder</h1>
      <div class="contact" aria-label="Primary contact">
        <span class="pill">📍 City (open to remote)</span>
        <a class="pill" href="mailto:you@example.com">✉️ you@example.com</a>
        <a class="pill" href="https://www.linkedin.com/in/yourname" target="_blank" rel="noopener">🔗 LinkedIn</a>
        <a class="pill" href="https://github.com/yourname" target="_blank" rel="noopener">💻 GitHub</a>
        <a class="pill" href="resume.pdf" download>📄 Download Résumé</a>
      </div>
      <div class="summary">
        <p>Previously: student leader running events &amp; mentorship. Proven record of turning messy data and fuzzy ideas into useful tools.</p>
      </div>
    </section>

