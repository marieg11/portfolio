  <script>
    // ===== Theme persistence & toggle =====
    const root = document.documentElement;
    const toggleBtn = document.getElementById('themeToggle');
    const icon = document.getElementById('themeIcon');
    //const label = document.getElementById('themeLabel');

    function applyTheme(mode){
      if(mode==='light'){
        root.classList.add('light');
        icon.textContent='☀️';
        //label.textContent='Light Mode';
        toggleBtn.setAttribute('title', 'Switch to dark mode');
        toggleBtn.setAttribute('aria-pressed','true');
      } else {
        root.classList.remove('light');
        icon.textContent='🌙';
        //label.textContent='Dark Mode';
        toggleBtn.setAttribute('title', 'Switch to light mode');
        toggleBtn.setAttribute('aria-pressed','false');
      }
      localStorage.setItem('theme', mode);
    }
    const saved = localStorage.getItem('theme');
    applyTheme(saved || 'light');

    toggleBtn.addEventListener('click', ()=>{
      const next = root.classList.contains('light') ? 'dark' : 'light';
      applyTheme(next);
    });

    document.getElementById('year').textContent=new Date().getFullYear();

    // Alternate sides for timelines if data-side omitted
    document.querySelectorAll('.timeline').forEach(tl=>{
      const items=[...tl.querySelectorAll('.item')];
      items.forEach((it,i)=>{ if(!it.dataset.side){ it.dataset.side = i%2? 'right':'left'; } });
    });

    // ===== Hamburger menu logic (all screen sizes) =====
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileMenuClose = document.getElementById('mobileMenuClose');

    function openMenu(){
      mobileMenu.classList.add('open');
      menuToggle.setAttribute('aria-expanded','true');
    }
    function closeMenu(){
      mobileMenu.classList.remove('open');
      menuToggle.setAttribute('aria-expanded','false');
    }

    if(menuToggle && mobileMenu){
      menuToggle.addEventListener('click', () => {
        if(mobileMenu.classList.contains('open')){
          closeMenu();
        } else {
          openMenu();
        }
      });
    }
    if(mobileMenuClose){
      mobileMenuClose.addEventListener('click', closeMenu);
    }
    if(mobileMenu){
      mobileMenu.querySelectorAll('a').forEach(link=>{
        link.addEventListener('click', closeMenu);
      });
    }

    // ===== Smooth scroll between sections without changing the URL hash =====
    document.querySelectorAll('[data-scroll]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();  // don't update hash / history

        const targetSelector = link.getAttribute('data-scroll');
        const target = document.querySelector(targetSelector);
        if (!target) return;

        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      });
    });

    // ===== Project video popup =====
    const projOverlay = document.getElementById('projVideoOverlay');
    const projVideo = document.getElementById('projVideo');
    const projClose = document.querySelector('.proj-video-close');

    function openProjectVideo(src){
      if(!projOverlay || !projVideo) return;
      projVideo.src = src;
      projOverlay.classList.add('open');
      projOverlay.setAttribute('aria-hidden','false');
      projVideo.play().catch(() => {});
    }

    function closeProjectVideo(){
      if(!projOverlay || !projVideo) return;
      projOverlay.classList.remove('open');
      projOverlay.setAttribute('aria-hidden','true');
      projVideo.pause();
      projVideo.removeAttribute('src'); // reset
      projVideo.load();
    }

    // Click on thumbnail button
    document.querySelectorAll('.proj-thumbnail-button').forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-video');
        if(src) openProjectVideo(src);
      });
    });

    // Close button
    if(projClose){
      projClose.addEventListener('click', closeProjectVideo);
    }

    /*
    // Click outside the video (on the dark backdrop)
    if(projOverlay){
      projOverlay.addEventListener('click', (e) => {
        if(e.target === projOverlay){
          closeProjectVideo();
        }
      });
    }*/

    // menu’s top edge will always sit exactly flush with the bottom edge of the header
    const header = document.querySelector('header');
    function updateHeaderHeight(){
      if (!header) return;
      const h = header.offsetHeight;
      document.documentElement.style.setProperty('--header-height', h + 'px');
    }
    updateHeaderHeight();
    window.addEventListener('resize', updateHeaderHeight);
    
  </script>
